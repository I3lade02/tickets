# --- Required -------------------------------------------------------------
# Added automatically when you connect a Neon database in Vercel > Storage.
DATABASE_URL=

# The password you log in with at /login. Make it long.
ADMIN_PASSWORD=

# Random string that signs your login cookie. Generate one with:
#   openssl rand -base64 32
# Changing it logs you out everywhere.
SESSION_SECRET=

# --- Optional -------------------------------------------------------------
# Time zone for dates in the dashboard (defaults to UTC).
DISPLAY_TIMEZONE=Europe/Prague

# Email via Resend (resend.com). Without RESEND_API_KEY no email is sent at all.
RESEND_API_KEY=
# Where "new ticket" alerts go.
NOTIFY_EMAIL=
# Sender for replies and confirmations. Must be on a domain you verified in Resend,
# e.g. Support <support@yourdomain.com>. Replying from the dashboard needs this.
EMAIL_FROM=
# Where customers' answers to your replies land (defaults to NOTIFY_EMAIL).
REPLY_TO_EMAIL=
# Set to true to email customers a "we got your message" receipt. Needs EMAIL_FROM.
SEND_CONFIRMATION=false

# Public URL of this app, used for links in alert emails.
# Only needed if you use a custom domain; otherwise it's detected.
APP_URL=
